{
  "$comment": "Test Model shape. Include every array field even when empty: a missing field makes the later computation skip that category silently.",
  "type": "object",
  "required": ["feature", "summary", "actors", "inputs", "partitions", "boundaries", "states", "transitions", "businessRules", "decisionTables", "apiAspects", "risks", "openQuestions", "citations"],
  "properties": {
    "feature": { "type": "string" },
    "summary": { "type": "string", "description": "One or two sentences on what this feature does" },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "permissions"],
        "properties": { "name": { "type": "string" }, "permissions": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Do not list boundary values here. Record the constraints; a script computes the values.",
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "constraints"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" },
          "constraints": {
            "type": "object",
            "properties": {
              "min": { "type": "number" }, "max": { "type": "number" },
              "minLength": { "type": "number" }, "maxLength": { "type": "number" },
              "pattern": { "type": "string" }, "format": { "type": "string" },
              "enumValues": { "type": "array", "items": { "type": "string" } }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "partitions": {
      "type": "array",
      "description": "Only groups that exist in the spec alone. Those implied by the constraints are generated by a script.",
      "items": {
        "type": "object",
        "required": ["id", "input", "valid", "invalid"],
        "properties": {
          "id": { "type": "string", "description": "starts with EP-" },
          "input": { "type": "string" },
          "valid": { "type": "array", "items": { "type": "string" } },
          "invalid": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "description": "Only boundaries the spec states explicitly (for example, zero is not allowed).",
      "items": {
        "type": "object",
        "required": ["id", "input", "values"],
        "properties": {
          "id": { "type": "string", "description": "starts with BV-" },
          "input": { "type": "string" },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "kind", "expectation"],
              "properties": {
                "value": { "type": "string" },
                "kind": { "type": "string", "enum": ["below", "on", "above"] },
                "expectation": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": { "name": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "transitions": {
      "type": "array",
      "description": "Include transitions that must not happen.",
      "items": {
        "type": "object",
        "required": ["id", "from", "event", "to"],
        "properties": {
          "id": { "type": "string", "description": "starts with TR-" },
          "from": { "type": "string" }, "event": { "type": "string" }, "to": { "type": "string" },
          "guard": { "type": "string" }
        }
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "source"],
        "properties": {
          "id": { "type": "string", "description": "starts with BR-" },
          "rule": { "type": "string" },
          "source": { "type": "string", "description": "A quote from the spec. If no quotable wording exists, do not record the rule." }
        }
      }
    },
    "decisionTables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "conditions", "rules"],
        "properties": {
          "id": { "type": "string", "description": "starts with DT-" },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["conditionValues", "action"],
              "properties": {
                "conditionValues": { "type": "array", "items": { "type": "string" }, "description": "T / F / - / N/A" },
                "action": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "apiAspects": {
      "type": "array",
      "description": "Technical aspects the spec does not cover: auth, permissions, concurrency, idempotency, timeouts, payload size.",
      "items": {
        "type": "object",
        "required": ["endpoint", "method", "statusCodes", "technicalRisks"],
        "properties": {
          "endpoint": { "type": "string" }, "method": { "type": "string" },
          "statusCodes": { "type": "array", "items": { "type": "string" } },
          "technicalRisks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "likelihood", "impact", "priority"],
        "properties": {
          "id": { "type": "string", "description": "starts with RISK-" },
          "description": { "type": "string" },
          "likelihood": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "impact": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "description": "What the spec does not answer. Record it here instead of guessing.",
      "items": {
        "type": "object",
        "required": ["question", "why", "blocksTesting"],
        "properties": {
          "question": { "type": "string" },
          "why": { "type": "string", "description": "Which case cannot be written without this answer" },
          "blocksTesting": { "type": "boolean" }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source"],
        "properties": { "claim": { "type": "string" }, "source": { "type": "string" } }
      }
    }
  }
}
